# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values.
# Every variable marked REQUIRED makes the application refuse to start.
# ---------------------------------------------------------------------------

# --- Anthropic (REQUIRED) ---------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-5-5

# --- WhatsApp Cloud API (REQUIRED) -----------------------------------------
# Meta Cloud API access token (System User token or a temporary 24h token).
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxx
# The sender's phone number id (WhatsApp > API Setup > From).
WHATSAPP_PHONE_ID=123456789012345
# Token you choose; Meta echoes it during the webhook verification handshake.
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
# Meta App Secret (App Settings > Basic). Used to sign/verify webhook payloads.
WHATSAPP_APP_SECRET=your-meta-app-secret
# Your own WhatsApp number, digits only, in international format.
# Only messages coming from this number are processed.
MY_WHATSAPP_NUMBER=923001234567
# Optional: approved template used when the 24 hour window is closed.
WHATSAPP_TEMPLATE_NAME=daily_summary_opener
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Gmail ------------------------------------------------------------------
# Path to the OAuth token produced by scripts/gmail_auth.py.
GMAIL_TOKEN_PATH=token.json

# --- Scheduling -------------------------------------------------------------
# Hour (0-23) of the daily summary, in SUMMARY_TIMEZONE.
SUMMARY_HOUR=8
SUMMARY_MINUTE=0
SUMMARY_TIMEZONE=Asia/Karachi
# How often the inbox is polled for new mail.
POLL_INTERVAL_MINUTES=2

# --- Storage / Database -----------------------------------------------------
# PostgreSQL is PRIMARY when DATABASE_URL is set (recommended with Docker).
# Leave DATABASE_URL empty to use SQLite at DB_PATH (local dev / tests).
# Docker Compose default (when running the app container with the postgres service):
# DATABASE_URL=postgresql://email_agent:change-me-postgres@postgres:5432/email_agent
DATABASE_URL=

# SQLite fallback path (used only when DATABASE_URL is empty).
DB_PATH=data/agent.db

# Docker Compose PostgreSQL service settings (used by docker-compose.yml).
POSTGRES_DB=email_agent
POSTGRES_USER=email_agent
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
APP_PORT=8000

# --- Admin UI (credentials for /admin dashboard) ----------------------------
# The admin UI is enabled only when both ADMIN_PASSWORD and ADMIN_SECRET_KEY
# are set. Use a long random ADMIN_SECRET_KEY for cookie signing.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_SECRET_KEY=choose-a-long-random-admin-secret

# --- MCP (REQUIRED) ---------------------------------------------------------
# Bearer token required by the /mcp endpoint.
MCP_API_KEY=choose-a-long-random-token

# --- Optional tuning --------------------------------------------------------
LOG_LEVEL=INFO
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
MAX_EMAIL_BODY_CHARS=6000
ERROR_NOTICE_COOLDOWN_MINUTES=30
GMAIL_MAX_RESULTS=50
